# API Server Configuration
PORT=3000
NODE_ENV=development

# APIキー認証設定
# true: 認証を有効化 / false: 認証をスキップ（ローカル開発用）
API_KEY_ENABLED=true
API_KEY=dev-api-key-12345-change-in-production

# Azure Blob Storage 設定
# AZURE_STORAGE_CONNECTION_STRING: Azure Storage の接続文字列
# 形式: DefaultEndpointsProtocol=https://;AccountName=<name>;AccountKey=<key>;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONNECTION_STRING=

# Blob Storage コンテナ名
AZURE_STORAGE_CONTAINER=documents

# Blob Storage 有効化フラグ
# true: ファイルを Blob Storage に保存 / false: メモリ処理のみ
AZURE_STORAGE_ENABLED=false

# SAS トークン有効期限（時間）
AZURE_STORAGE_SAS_EXPIRY_HOURS=24
